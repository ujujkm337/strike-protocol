; Engine configuration file — Godot 4.7
; Shoothouse/Competitive FPS. Рендер: Forward+ (SDFGI вместо Lumen).

[application]

config/name="Strike Protocol"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Boot="*res://scripts/core/boot_settings.gd"
Net="*res://scripts/network/net_manager.gd"
GameRulez="*res://scripts/core/game_rules.gd"
AudioBus="*res://scripts/core/audio_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"physical_keycode":87)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"physical_keycode":83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"physical_keycode":68)]
}
crouch={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"physical_keycode":4194326)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"physical_keycode":32)]
}
reload={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"physical_keycode":82)]
}
fire={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":1)]
}
aim={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":2)]
}
weapon_next={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":4)]
}
weapon_prev={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":5)]
}
scoreboard={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"physical_keycode":4194335)]
}
menu={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"physical_keycode":4194305)]
}

[network]

limits/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/dir_shadow_1st_angle_size=2048
lights_and_shadows/shadow_cubemap_size=512
lights_and_shadows/positional_shadow_atlas_size=1024
lights_and_shadows/positional_shadow_atlas_quad_0=9
lights_and_shadows/positional_shadow_atlas_quad_1=9
lights_and_shadows/positional_shadow_atlas_quad_2=18
lights_and_shadows/positional_shadow_atlas_quad_3=36
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=4
